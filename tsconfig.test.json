{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": ".test-dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/types.ts",
    "src/data.ts",
    "src/domain/**/*.ts",
    "src/v5/domain/**/*.ts",
    "src/v5/application/**/*.ts",
    "tests/**/*.ts"
  ]
}
